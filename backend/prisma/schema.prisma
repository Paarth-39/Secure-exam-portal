datasource db {
  provider  = "postgresql"
  url        = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN

  @@map("user_role")
}

enum AuthProvider {
  LOCAL
  GOOGLE

  @@map("auth_provider")
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED

  @@map("exam_status")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT

  @@map("attempt_status")
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName            String               @map("full_name") @db.VarChar(100)
  email               String               @unique @db.VarChar(255)
  passwordHash        String?              @map("password_hash") @db.VarChar(255)
  role                UserRole             @default(STUDENT)
  provider            AuthProvider         @default(LOCAL)
  emailVerified       Boolean              @default(false) @map("email_verified")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  examsCreated        Exam[]
  attempts            Attempt[]
  auditLogs           AuditLog[]

  @@map("users")
}

model VerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  used      Boolean  @default(false)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  revoked   Boolean  @default(false)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("refresh_tokens")
}

model Subject {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(100)
  exams Exam[]

  @@map("subjects")
}

model Exam {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String      @db.VarChar(200)
  subjectId       Int?        @map("subject_id")
  duration        Int
  totalMarks      Int         @map("total_marks")
  createdBy       String      @map("created_by") @db.Uuid
  startTime       DateTime    @map("start_time") @db.Timestamptz()
  endTime         DateTime    @map("end_time") @db.Timestamptz()
  status          ExamStatus  @default(DRAFT)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  
  subject         Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  creator         User        @relation(fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questions       Question[]
  attempts        Attempt[]

  @@map("exams")
}

model Question {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId        String   @map("exam_id") @db.Uuid
  question      String
  optionA       String   @map("option_a")
  optionB       String   @map("option_b")
  optionC       String   @map("option_c")
  optionD       String   @map("option_d")
  correctOption String   @map("correct_option") @db.Char(1)
  marks         Int      @default(1)
  
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  answers       Answer[]

  @@map("questions")
}

model Attempt {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String        @map("student_id") @db.Uuid
  examId     String        @map("exam_id") @db.Uuid
  startTime  DateTime      @default(now()) @map("start_time") @db.Timestamptz()
  submitTime DateTime?     @map("submit_time") @db.Timestamptz()
  score      Int?
  status     AttemptStatus @default(IN_PROGRESS)
  
  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  exam       Exam          @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  answers    Answer[]

  @@unique([studentId, examId], name: "uq_student_exam")
  @@map("attempts")
}

model Answer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId      String   @map("attempt_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  selectedOption String?  @map("selected_option") @db.Char(1)
  
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("answers")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  device    String?
  timestamp DateTime @default(now()) @db.Timestamptz()
  
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("audit_logs")
}
